{
  "name": "file2quicknote",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Create or open a same-named Markdown note next to any vault file.",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsc --project tsconfig.json --outDir .test-build && node --test"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "obsidian": "^1.14.4",
    "typescript": "^5.9.3"
  }
}
